{
  "manifest_version": 3,
  "name": "Markdown to PDF & DOCX",
  "version": "2.0.0",
  "description": "Convert Markdown to professional PDF and editable DOCX. Works offline, completely free.",
  "permissions": ["activeTab", "scripting", "storage"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Markdown Converter"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "web_accessible_resources": [
    {
      "resources": ["print.html", "print-page.js", "libs/*", "ad-banner.png"],
      "matches": ["<all_urls>"]
    }
  ]
}